import atletas.*
import elementos.*
import disciplinas.*

describe "Enana Pareto" {
  test "Victoria se quiere parecer a Pareto (que mide 150 cms), se hace pequeña, 
  practica judo y por lo tanto necesita un judogi." {

     victoria.cambiarAltura(150)
     victoria.cambiarDisciplina(judo)
     victoria.cambiarElemento(judogi)
    
    assert.equals(victoria.altura(), 150)
    assert.equals(victoria.disciplina(), judo)
    assert.equals(victoria.elemento(), judogi)
  }
}

describe "Del Potro" {
  test "Victoria ahora se quiere parecer a Delpo y empieza a practicar tenis. Elonga con intensidad hasta llegar a los dos metros diez, 
  necesita una raqueta y tiene dos entrenadores." {
    
    victoria.cambiarAltura(210)
    victoria.cambiarDisciplina(tenis)
    victoria.cambiarElemento(raqueta)

    assert.equals(victoria.altura(), 210)
    assert.equals(victoria.disciplina(), tenis)
    assert.equals(victoria.elemento(), raqueta)
  }
}

describe "Lucha Aymar" {
  test "Victoria quiere ser luciana Aymar y mide 180 juega hockey y usa stick" {

    victoria.cambiarAltura(180)
    victoria.cambiarDisciplina(hockey)
    victoria.cambiarElemento(stick)

    assert.equals(victoria.altura(), 180)
    assert.equals(victoria.disciplina(), hockey)
    assert.equals(victoria.elemento(), stick) 
  }

}

describe "name" {
  test "victoria agarra la raqueta para practicar judo con la altura de lucha" {

    victoria.cambiarAltura(180)
    victoria.cambiarDisciplina(judo)
    victoria.cambiarElemento(raqueta)

    assert.equals(victoria.altura(), 180)
    assert.equals(victoria.disciplina(), judo)
    assert.equals(victoria.elemento(), raqueta)  
  }
}